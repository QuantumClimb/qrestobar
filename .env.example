# QBAR & RESTAURANT - Environment Configuration
# Temporary Demo Authentication & Storage Mode
# IMPORTANT: VITE_* environment variables are embedded in client-side bundles and are NOT secure secrets.
# This demo password gate is strictly for temporary client showcase and must be replaced with Supabase Auth in production.
VITE_DEMO_MODE=true
VITE_DEMO_ADMIN_PASSWORD=

# Optional: Supabase Integration (Leave empty to use built-in demo mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
